# Canvasstr environment overrides. Copy to `.env.local` (gitignored) to use.
# Every value is optional. No relay is privileged.

# Swap the shipped default relay without editing code.
# VITE_DEFAULT_RELAY=wss://relay.example.com

# Point the whole app at one relay (custom mode), e.g. the local strfry from `npm run relay:up`.
# VITE_RELAY_URL=ws://127.0.0.1:7787

# Default point of view (npub or hex). Used when the viewer has no POV of their own.
# VITE_DEFAULT_POV=npub19mafcphw76xa4hmt4k2xhwqzvmg3vaq3wewyx4j0ayxt7jssnyqqgu3uac

# House POV provider (hex pubkey of a Tapestry deployment assistant) used when no other lens resolves.
# Default: tapestry.brainstorm.world assistant (the tags.brainstorm.world one publishes no 30382s as of 2026-09-07).
# VITE_HOUSE_POV_PROVIDER=919ba08af7786892093b8264332d817379662a0ba0ba1f5c791ed7b62a7ee2ff
# VITE_NIP85_RELAY=wss://nip85.brainstorm.world

# Extra relays to look for zap receipts on (LNURL providers publish where they like).
# VITE_RECEIPT_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
