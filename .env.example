# Gleaner environment overrides. Copy to `.env.local` (gitignored) to use.
# Every value is optional. No relay is privileged.

# Swap the shipped default relay without editing code.
# VITE_DEFAULT_RELAY=wss://relay.example.com

# Point the whole app at one relay (custom mode), e.g. the local strfry from `npm run relay:up`.
# VITE_RELAY_URL=ws://127.0.0.1:7787

# Default point of view (npub or hex). Used when the viewer has no POV of their own.
# VITE_DEFAULT_POV=npub18yce33sv4tlgqy53js2s2u8pradnkhkmrpmp0x4x2tvg247p4dzq5m2c5f
